<?xml version="1.0" encoding="utf-8"?>
<!--
     The Rectobook mark: an open book with only the right-hand page, the recto,
     lit, and a ribbon marking the place.

     Every point lies within 28dp of the centre, inside the 33dp safe circle
     every mask guarantees, so no launcher shape crops the book or the ribbon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The verso, left in shadow. -->
    <path
        android:pathData="M54,41 C46,36 39,36 32,38 L32,71 C39,69 46,69 54,74 Z"
        android:fillColor="#F2EEE4"
        android:fillAlpha="0.22" />

    <!-- The recto. -->
    <path
        android:pathData="M54,41 C62,36 69,36 76,38 L76,71 C69,69 62,69 54,74 Z"
        android:fillColor="#F2EEE4" />

    <!-- Its lines of text, drawn in the background colour rather than cut out:
         the background layer is a flat field, so the two cannot be told apart
         even while the launcher parallaxes one against the other. -->
    <path
        android:pathData="M59,51 H64 M59,56 H71 M59,61 H71 M59,66 H67"
        android:strokeColor="#5980A6"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- The ribbon. -->
    <path
        android:pathData="M66.5,33 H72.5 V49 L69.5,46 L66.5,49 Z"
        android:fillColor="#F26B3A" />
</vector>
