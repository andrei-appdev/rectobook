<?xml version="1.0" encoding="utf-8"?>
<!--
     The same mark for themed icons, where the system tints one flat shape
     with the wallpaper's colours.

     A tint leaves alpha as the only second tone, so everything the colour
     layer separates by colour is separated here by absence: the lines of text
     are holes in the recto, and so is a 0.6dp margin around the ribbon, which
     would otherwise merge into the page it lies on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The verso, at partial alpha. -->
    <path
        android:pathData="M54,41 C46,36 39,36 32,38 L32,71 C39,69 46,69 54,74 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35" />

    <!-- The recto, then the four lines as capsules, then the ribbon's margin.
         The margin's top runs along the page's own edge rather than past it:
         even-odd would fill whatever part of a hole lies outside the page. -->
    <path
        android:pathData="M54,41 C62,36 69,36 76,38 L76,71 C69,69 62,69 54,74 Z
            M59,50 H64 A1,1 0 0 1 64,52 H59 A1,1 0 0 1 59,50 Z
            M59,55 H71 A1,1 0 0 1 71,57 H59 A1,1 0 0 1 59,55 Z
            M59,60 H71 A1,1 0 0 1 71,62 H59 A1,1 0 0 1 59,60 Z
            M59,65 H67 A1,1 0 0 1 67,67 H59 A1,1 0 0 1 59,65 Z
            M65.9,50.448 V36.827 C68.341,36.63 70.729,36.824 73.1,37.294
            V50.449 L69.5,46.849 Z"
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd" />

    <!-- The ribbon. -->
    <path
        android:pathData="M66.5,33 H72.5 V49 L69.5,46 L66.5,49 Z"
        android:fillColor="#FFFFFF" />
</vector>
